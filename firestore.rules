rules_version = '2';
// Reglas de Firestore del proyecto gcarrerap-games, que es solo de este sitio (gcarrerap/games).
// Firestore tiene UN solo archivo de reglas por proyecto: publicar este archivo reemplaza todo lo publicado.
// Se publica desde la consola (Firestore → Reglas, pegar el archivo completo) o con
// `firebase deploy --only firestore:rules`. tests/platform/rules.test.js revisa que estén todas las colecciones.
service cloud.firestore {
  match /databases/{database}/documents {
    // Mesas de todos los juegos (platform/services/tables-repo.js). Cada una dice de qué juego es.
    match /juegos-mesas/{code} {
      allow read, delete: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.json is string
        && request.resource.data.json.size() < 900000
        && request.resource.data.game is string
        && request.resource.data.code == code;
    }
    // Partidas grabadas (platform/services/recordings.js): solo se crean, una vez por id. Se leen con scripts.
    match /juegos-grabaciones/{id} {
      allow create: if request.auth != null
        && request.resource.data.json is string
        && request.resource.data.json.size() < 900000
        && request.resource.data.game is string;
      allow read, update, delete: if false;
    }
    // Llamadas de voz y video de cada mesa (platform/services/call-signaling.js): quién está (peers) y los mensajes
    // para conectarse (signals). El audio y el video no pasan por Firestore, van directo entre teléfonos.
    match /juegos-llamadas/{mesa}/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
