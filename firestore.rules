rules_version = '2';
// Reglas del proyecto de Firebase "dominomx", que comparten myDomino y este sitio.
// OJO: publicar reglas REEMPLAZA todas las del proyecto. Este archivo debe llevar también las de myDomino
// (copiadas tal cual de su firestore.rules) mientras myDomino siga en línea.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- myDomino (sin cambios) ----------
    // Mesas en línea: cualquier jugador con sesión (los invitados entran de forma anónima)
    match /mesas/{mesa} {
      allow read, write: if request.auth != null;
    }
    // Manos grabadas: solo se crean, una vez por id
    match /manos/{mano} {
      allow create: if request.auth != null
        && request.resource.data.json is string
        && request.resource.data.json.size() < 200000;
      allow read, update, delete: if false;
    }

    // ---------- Juegos de la Familia (este sitio) ----------
    // Mesas de todos los juegos (platform/services/tables-repo.js). Cada una dice de qué juego es.
    match /juegos-mesas/{code} {
      allow read, delete: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.json is string
        && request.resource.data.json.size() < 900000
        && request.resource.data.game is string
        && request.resource.data.code == code;
    }
    // Partidas grabadas (platform/services/recordings.js): solo se crean, una vez por id. Se leen con scripts.
    match /juegos-grabaciones/{id} {
      allow create: if request.auth != null
        && request.resource.data.json is string
        && request.resource.data.json.size() < 900000
        && request.resource.data.game is string;
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
